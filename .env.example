# .env.example
# This file lists the environment variables required for the project.
# Create a .env file in the root directory and copy these variables, then fill in your values.

# Frontend (apps/client)
# The URL where the backend API is running.
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Backend (apps/server)
# The port on which the Express.js server will listen.
PORT=5000

# PostgreSQL Database Connection URL.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://user:password@localhost:5432/invoicedb?schema=public"

# CORS origin for the frontend application.
# This should match the URL where your Next.js app is running.
CORS_ORIGIN=http://localhost:3000
